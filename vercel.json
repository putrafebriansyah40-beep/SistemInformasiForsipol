{
    "version": 2,
    "regions": [
        "sin1"
    ],
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.9.0"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(robots\\.txt|sitemap\\.xml|favicon\\.ico|apple-touch-icon\\.png|googlead4bdcab924d1c0e\\.html)",
            "dest": "/public/$1"
        },
        {
            "src": "/(build|images|assets|js|css)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}